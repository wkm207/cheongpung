rules_version = '2';

// Country of Wind 서버 저장: users/{uid}/slots/{0~3}
// 로그인한 사람은 자기 uid 아래 저장만 읽고 쓸 수 있다. 그 밖의 모든 문서는 막는다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/slots/{slot} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && slot in ['0', '1', '2', '3']
        && request.resource.data.text is string
        && request.resource.data.text.size() < 500000
        && request.resource.data.savedAt is string;
    }
  }
}
